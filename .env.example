# Defaults for compose.yaml + compose.local.yaml.
# For an existing external LiteLLM server, change the endpoint and key.
LITELLM_CHAT_COMPLETIONS_URL=http://litellm:4000/v1/chat/completions
LITELLM_MODEL=local-vision
# Generate secrets using the README command; never commit the resulting .env.
LITELLM_API_KEY=
POSTGRES_PASSWORD=
LITELLM_UI_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_TEST_PASSWORD=
OIDC_CLIENT_SECRET=
OAUTH2_COOKIE_SECRET=
DOCLING_PORT=5001
LITELLM_PORT=4000

# Small document VLM downloaded automatically into the Ollama volume.
OLLAMA_MODEL=ibm/granite-docling:258m
VLM_RESPONSE_FORMAT=doctags
VLM_PROMPT=Convert this page to docling.
# For general-purpose vision models, change BOTH settings:
# VLM_RESPONSE_FORMAT=markdown
# VLM_PROMPT=Convert this page to markdown. Do not miss any text and only output the bare markdown!
