# Full OpenAI-compatible chat-completions URL, reachable FROM the container.
LITELLM_CHAT_COMPLETIONS_URL=http://host.docker.internal:4000/v1/chat/completions
# Use the model_name alias configured in your existing LiteLLM proxy.
LITELLM_MODEL=local-vision
# Replace with your LiteLLM virtual key; leave empty only if auth is disabled.
LITELLM_API_KEY=
DOCLING_PORT=5001

# Defaults suit general-purpose vision models. For Granite Docling, use:
# VLM_RESPONSE_FORMAT=doctags
# VLM_PROMPT=Convert this page to docling.
VLM_RESPONSE_FORMAT=markdown
VLM_PROMPT=Convert this page to markdown. Do not miss any text and only output the bare markdown!
